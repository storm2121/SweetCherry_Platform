{
  "name": "sweetcherry-functions",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "dataset:dry-run": "node scripts/prepareLegacyLeafDatasetImport.mjs --dry-run",
    "dataset:upload": "node scripts/prepareLegacyLeafDatasetImport.mjs --upload",
    "training:export": "node scripts/exportTrainingSetManifest.mjs",
