# Local demo: no Firebase account or server API key is needed.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-sweetcherry
VITE_FIREBASE_STORAGE_BUCKET=demo-sweetcherry.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# For your own Firebase project, set VITE_USE_EMULATORS=false and replace
# the Firebase web configuration above with the values from your console.
# Optional map rendering:
VITE_MAPBOX_TOKEN=

# OPENAI_API_KEY and ELEVENLABS_API_KEY belong in Functions secrets.
# Never put server secrets in VITE_* variables.
